# Live smoke test credentials - copy to .env (gitignored) and fill in.
# The variable names are the ones the providers themselves read.

# anthropic provider: a workspace-scoped Claude API key (sk-ant-api...),
# created in the Claude Console (Settings > API keys). The live suite is
# read-only apart from one 16-token completion on the cheapest model.
ANTHROPIC_API_KEY=

# anthropic_admin provider: an org-scoped Admin API key (sk-ant-admin01-...),
# created by an organization admin (Settings > Admin keys). The admin live
# suite is READ-ONLY. ANTHROPIC_ADMIN_API_KEY is accepted as an alias by
# tests/smoke.py and copied into ANTHROPIC_ADMIN_KEY when that is unset.
ANTHROPIC_ADMIN_KEY=

# Optional. A workspace id (wrkspc_...) the key can act on; enables the
# workspace-scoped models test in the anthropic live suite.
ANTHROPIC_WORKSPACE_ID=

# Optional. Set to 1 to include the managed-agents write lifecycle
# (create / get / archive, named stackql-smoke-*) in the anthropic live
# suite - needs a key enrolled in the managed agents beta.
SMOKE_AGENTS=
